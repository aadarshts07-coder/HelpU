// Prisma Schema for HELP U Autonomous Career Assistant

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String          @id @default(uuid())
  email                String          @unique
  name                 String
  phone                String?
  location             String?
  linkedInUrl          String?
  githubUrl            String?
  portfolioUrl         String?
  summary              String?
  workPreference       String          @default("remote") // remote, hybrid, onsite, any
  workAuthorization    String?
  targetJobTitles      String[]
  preferredLocations   String[]
  salaryMin            Int?
  salaryMax            Int?
  salaryCurrency       String          @default("USD")
  industries           String[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  education            Education[]
  experience           Experience[]
  skills               Skill[]
  projects             Project[]
  certifications       Certification[]
  languages            Language[]
  resumeVersions       ResumeVersion[]
  applications         Application[]
  settings             Settings?
  notifications        Notification[]
}

model Education {
  id           String   @id @default(uuid())
  userId       String
  institution  String
  degree       String
  fieldOfStudy String
  startDate    String
  endDate      String
  current      Boolean  @default(false)
  grade        String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Experience {
  id          String   @id @default(uuid())
  userId      String
  company     String
  position    String
  location    String?
  startDate   String
  endDate     String?
  current     Boolean  @default(false)
  description String?
  highlights  String[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id       String @id @default(uuid())
  userId   String
  name     String
  category String @default("Technical")
  level    String @default("Intermediate")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String
  techStack   String[]
  liveUrl     String?
  repoUrl     String?
  bullets     String[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Certification {
  id             String  @id @default(uuid())
  userId         String
  name           String
  issuer         String
  issueDate      String
  expirationDate String?
  credentialId   String?
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Language {
  id          String @id @default(uuid())
  userId      String
  name        String
  proficiency String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResumeVersion {
  id          String   @id @default(uuid())
  userId      String
  version     Int      @default(1)
  label       String   // "v1", "v2"
  resumeData  Json     // Full ATS resume JSON structure
  coverLetter String   @db.Text
  docxUrl     String?
  pdfUrl      String?
  targetRole  String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Application {
  id                     String    @id @default(uuid())
  userId                 String
  jobId                  String
  jobTitle               String
  company                String
  location               String?
  portal                 String
  applyUrl               String
  matchScore             Int
  status                 String    // Found, Tailored, Awaiting Review, Applied, Failed, Interview, Rejected, Needs attention
  statusReason           String?
  tailoredResumeVersion  String?   // "v1", "v2"
  screenshots            String[]
  questionsAnswered      Json?
  requiresAttentionReason String?
  appliedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Settings {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  dailyApplicationLimit  Int       @default(20)
  jobMatchThreshold      Int       @default(75) // Default 75 per prompt requirement
  reviewMode             String    @default("ask_before_submitting") // auto_submit | ask_before_submitting
  isPaused               Boolean   @default(false)
  blacklistedCompanies   String[]
  blacklistedKeywords    String[]
  consentGiven           Boolean   @default(true)
  consentTimestamp       DateTime?
  emailNotifications     Boolean   @default(true)
  notificationEmail      String?
  encryptedCredentials   String?   // AES-256 encrypted portal passwords
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
