# ========================================================
# HELP U - Environment Template (.env.example)
# Copy this file to .env.local and fill in your values
# ========================================================

# Base URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Demo User Credentials (Optional)
NEXT_PUBLIC_DEMO_EMAIL="your_email@example.com"
NEXT_PUBLIC_DEMO_PASSWORD="your_secure_password"

# AI - Anthropic Claude API Key (Optional: fallbacks to simulated ATS Claude generator if empty)
ANTHROPIC_API_KEY=""

# PostgreSQL Database Connection
DATABASE_URL="postgresql://username:password@localhost:5432/helpu?schema=public"
POSTGRES_USER="your_postgres_user"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="helpu"

# Redis Cache & BullMQ Background Queue
REDIS_URL="redis://localhost:6379"

# Security & Encryption - AES-256 Secret (At least 32 characters)
CREDENTIAL_ENCRYPTION_KEY="replace_with_random_32_character_secret_key"
CREDENTIAL_SALT="replace_with_random_salt_string"

# NextAuth / Session Secret
NEXTAUTH_SECRET="replace_with_random_jwt_secret_min_32_characters"

# Email Notifications (SMTP Credentials)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HELP U Job Assistant <notifications@yourdomain.com>"

# Job Automation Defaults
DEFAULT_DAILY_APPLICATION_LIMIT=20
DEFAULT_MATCH_THRESHOLD=70
DEFAULT_REVIEW_MODE="ask_before_submitting"

# FreeHire API Key
FREEHIRE_API_KEY=""
FREEHIRE_COMMERCIAL_MODE="false"

# Certification Discovery & Evidence Adapters (Optional)
CREDLY_API_TOKEN=""
MICROSOFT_LEARN_API_KEY=""
COURSERA_PARTNER_KEY=""
